# Application
APP_ENV=development
APP_DEBUG=1
APP_DEFAULT_LANG=ru
APP_BASE_URL=https://example.test/

# Почта (Symfony Mailer)
# DSN: smtp://user:pass@smtp.example.com:587  или  sendmail://default  или  native://default
MAILER_DSN=smtp://localhost:25
MAIL_TO=info@example.com
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME="Экосистема итали"
MAIL_SUBJECT_PREFIX=[italy]

# Analytics (опционально)
# YANDEX_METRIC_ID=12345678

# Эквайринг Альфа-Банка (оплата билетов). Без учётных данных оплата не включается.
PAYMENT_ENABLED=0
# prod — https://pay.alfabank.ru/payment/rest, test — https://alfa.rbsuat.com/payment/rest
PAYMENT_ENV=test
# логин магазина с суффиксом -api и пароль из личного кабинета (либо PAYMENT_TOKEN вместо пары)
PAYMENT_USERNAME=
PAYMENT_PASSWORD=
# PAYMENT_TOKEN=
# Ключ контрольной суммы callback-уведомлений (ЛК банка → Настройки → Callback-уведомления).
# Пока пуст, /pay/callback отвечает 503: оплата подтверждается только возвратом покупателя,
# и заказ остаётся pending, если клиент закрыл вкладку на странице банка.
PAYMENT_CALLBACK_TOKEN=
# база для returnUrl/failUrl; по умолчанию берётся APP_BASE_URL
# PAYMENT_RETURN_BASE=https://italycommunity.ru
# PAYMENT_CURRENCY=810
# PAYMENT_DESCRIPTION="Покупка билета — Экосистема итали"
# PAYMENT_ITEM_NAME="Электронный билет"
# PAYMENT_SESSION_TIMEOUT=1200
# Корзина чека (54-ФЗ) в orderBundle — включать только при фискализации на стороне банка.
# tax_type: 0 — без НДС, 1 — 0%, 2 — 10%, 6 — 20%
PAYMENT_FISCAL_ENABLED=0
# PAYMENT_FISCAL_TAX_TYPE=0
# PAYMENT_FISCAL_MEASURE=шт

{% extends 'base.twig' %}

{% block content %}
<div id="page-content">
  {% include 'sections/header.twig' with {'data': {}} %}
  <main class="restaurant-detail" role="main">
    {% set r = restaurant.restaurant %}

    {% if restaurant.covers is defined and restaurant.covers|length > 0 %}
      <section class="restaurant-detail__item slider-wrap restaurant-intro">
        <div class="swiper-container" id="restaurantSlider" data-settings="{{ {
          loop: true,
          autoplay: { delay: 5000, disableOnInteraction: false },
          pagination: { enabled: true, clickable: true },
          navigation: { enabled: true },
          effect: 'fade',
          speed: 800
        }|json_encode }}">
          <div class="swiper-wrapper">
            {% for cover in restaurant.covers %}
              <div class="swiper-slide">
                {% include 'components/picture.twig' with {
                  image: cover,
                  alt: cover.alt|default(r.name),
                  class: 'img-responsive',
                  sizes_preset: 'hero',
                  loading: loop.first ? 'eager' : 'lazy'
                } only %}
              </div>
            {% endfor %}
          </div>
          <div class="swiper-pagination"></div>
          <div class="swiper-button-next"></div>
          <div class="swiper-button-prev"></div>
        </div>

        <div class="restaurant-intro__overlay">
          <div class="container">
            <div class="restaurant-intro__content">
              <h1 class="restaurant-intro__title heading font-1 weight-300 uppercase">{{ r.nameHtml is defined and r.nameHtml ? r.nameHtml|raw : r.name }}</h1>

              <div class="restaurant-intro__contacts">
                {% if r.address is defined %}
                  <p class="restaurant-intro__line">{{ r.address.addressLocality }}{% if r.address.streetAddress %}, {{ r.address.streetAddress }}{% endif %}</p>
                {% endif %}
                {% if r.telephone is defined %}
                  <a href="{{ r.telephone.href }}" class="restaurant-intro__line link">{{ r.telephone.title|default(r.telephone.href) }}</a>
                {% endif %}
              </div>

              {% set _hours = r.openingHours | default([]) %}
              {% if r.openingHoursFrom is defined and ("now"|date("Ymd")) >= (r.openingHoursFrom.date|date("Ymd")) %}
                {% set _hours = r.openingHoursFrom.list %}
              {% endif %}
              {% if _hours|length > 0 %}
                <div class="restaurant-intro__hours">
                  <div class="restaurant-intro__hours-title">
                    <span class="restaurant-intro__hours-icon" aria-hidden="true"></span>
                    <span>Часы работы:</span>
                  </div>
                  {% for h in _hours %}
                    <div class="restaurant-intro__hours-row">{{ h.days }}: {{ h.hours }}</div>
                  {% endfor %}
                  {% if r.hoursNotes is defined and r.hoursNotes|length > 0 %}
                    {% for note in r.hoursNotes %}
                      <p class="restaurant-intro__hours-note">{{ note }}</p>
                    {% endfor %}
                  {% endif %}
                </div>
              {% endif %}

              {% if r.bookingPoint is defined or r.menuLink is defined or r.barMenuLink is defined %}
                <div class="restaurant-intro__actions">
                  {% if r.menuLink is defined and r.menuLink %}
                    <a href="{{ r.menuLink }}" target="_blank" rel="noopener noreferrer" data-ym-goal="menu_click" class="button button-md outline-color-1 color-1 uppercase link">Меню</a>
                  {% endif %}
                  {% if r.barMenuLink is defined and r.barMenuLink %}
                    <a href="{{ r.barMenuLink }}" target="_blank" rel="noopener noreferrer" class="button button-md outline-color-1 color-1 uppercase link">Барная карта</a>
                  {% endif %}
                  {% if r.bookingPoint is defined and r.bookingPoint %}
                    <button type="button" class="button button-md bg-color-1 color-2 uppercase link widget__point__{{ r.bookingPoint }}">Забронировать</button>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </section>
    {% endif %}

    {# ---- О ресторане: лого + текст + CTA + галерея ---- #}
    <section class="restaurant-detail__item about-wrap section">
      <div class="container-md">
        {% set aboutLogo = restaurant.logos is defined ? (restaurant.logos[0]|default(null)) : null %}
        {% if aboutLogo and aboutLogo.src %}
          <div class="section__item restaurant-about__logo">
            <img src="{{ url(aboutLogo.src) }}" alt="{{ aboutLogo.alt|default(r.name) }}"
                 style="height: {{ aboutLogo.height|default('6.5rem') }};" loading="lazy">
          </div>
        {% endif %}

        {% if restaurant.desc.short is defined and restaurant.desc.short %}
          <div class="section__item heading-wrap">
            <p class="restaurant-about__sub">{{ restaurant.desc.short }}</p>
          </div>
        {% endif %}

        {% if restaurant.desc.heading is defined and restaurant.desc.heading %}
          <div class="section__item heading-wrap">
            <h2 class="restaurant-about__sub">{{ restaurant.desc.heading }}</h2>
          </div>
        {% endif %}

        {% if restaurant.desc is defined and restaurant.desc.full is defined %}
          {% set descParas = restaurant.desc.full is iterable ? restaurant.desc.full : [restaurant.desc.full] %}
          <div class="section__item desc-wrap">
            {% for para in descParas %}
              <p class="restaurant-about__col">{{ para|raw }}</p>
            {% endfor %}
          </div>
        {% endif %}

        {# Развёрнутый рассказ блоками: подзаголовки нужны и читателю, и поиску —
           сплошное полотно на 500 слов не читают. #}
        {% if restaurant.desc.blocks is defined and restaurant.desc.blocks|length > 0 %}
          <div class="section__item restaurant-story">
            {% for block in restaurant.desc.blocks %}
              <div class="restaurant-story__block">
                {% if block.heading is defined %}
                  <h2 class="restaurant-story__heading">{{ block.heading }}</h2>
                {% endif %}
                {% for para in (block.text is iterable ? block.text : [block.text]) %}
                  <p class="restaurant-story__text">{{ para|raw }}</p>
                {% endfor %}
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {# Вопросы гостей: самый цитируемый ИИ-моделями формат, ответ — первым предложением #}
        {% if restaurant.faq is defined and restaurant.faq|length > 0 %}
          <div class="section__item restaurant-faq">
            <h2 class="restaurant-faq__heading uppercase">Частые вопросы</h2>
            <dl class="restaurant-faq__list">
              {% for qa in restaurant.faq %}
                <div class="restaurant-faq__item">
                  <dt class="restaurant-faq__q">{{ qa.q }}</dt>
                  <dd class="restaurant-faq__a">{{ qa.a|raw }}</dd>
                </div>
              {% endfor %}
            </dl>
          </div>
        {% endif %}


        {% if restaurant.staff is defined and restaurant.staff|length > 0 %}
          <div class="section__item restaurant-about__staff">
            <h2 class="restaurant-staff__heading uppercase">Команда</h2>
            <ul class="restaurant-staff__list">
              {% for member in restaurant.staff %}
                <li class="restaurant-staff__item">
                  <span class="restaurant-staff__role">{{ member.role }}</span>
                  <span class="restaurant-staff__name">{{ member.name }}</span>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        {% set galleryItems = restaurant.gallery|default(restaurant.covers|default([])) %}
        {% if galleryItems|length > 0 %}
          <div class="section__item restaurant-about__gallery" id="restaurantGallery">
            {% for img in galleryItems|slice(0, 4) %}
              <figure class="restaurant-about__photo">
                <a href="{{ url(img.src) }}" class="glightbox link" data-gallery="restaurant-gallery">
                  {% include 'components/picture.twig' with {
                    image: img,
                    alt: img.alt|default(r.name),
                    class: '',
                    sizes_preset: 'card',
                    loading: 'lazy'
                  } only %}
                </a>
              </figure>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </section>

    {# Соседи по городу: карточки группы между собой не связаны, а гость обычно выбирает
       из нескольких мест рядом. Заодно распределяет вес по внутренним страницам. #}
    {% set _city = r.address.addressLocality | default('') %}
    {% set _all = load_json('data/json/' ~ lang_code ~ '/pages/restaurants.json') %}
    {% set _nearby = (_all.items | default([]))
      | map(s => (load_json('data/json/' ~ lang_code ~ '/restaurants/' ~ s ~ '.json') | default({})) | merge({'slug': s}))
      | filter(e => e.visible | default(false)
          and e.restaurant is defined
          and e.slug != restaurant.slug
          and (e.restaurant.address.addressLocality | default('')) == _city)
      | slice(0, 4) %}

    {% if _nearby is not empty %}
      <section class="restaurant-detail__item restaurant-nearby section">
        <div class="container-md">
          <h2 class="restaurant-nearby__heading uppercase">Ещё в городе {{ _city }}</h2>
          <ul class="restaurant-nearby__list">
            {% for near in _nearby %}
              <li class="restaurant-nearby__item">
                <a href="{{ url('/restaurants/' ~ near.slug) }}" class="restaurant-nearby__link link">
                  <span class="restaurant-nearby__name">{{ near.restaurant.name }}</span>
                  <span class="restaurant-nearby__desc">{{ near.desc.short | default(near.restaurant.address.streetAddress | default('')) }}</span>
                </a>
              </li>
            {% endfor %}
          </ul>
          <a href="{{ url('/restaurants') }}" class="restaurant-nearby__all link">Все рестораны группы</a>
        </div>
      </section>
    {% endif %}

  </main>
  {% include 'sections/footer.twig' with {'data': {
    'background': { 'src': 'data/img/ui/bg3.webp' },
    'form': { 'heading': 'Будьте в курсе' }
  }} %}
</div>

{# Бронирование Remarked инициализируется глобально и лениво в assets/js/sections/booking.js
   (кнопка .widget__point__{{ r.bookingPoint }} выше; точки — в components/remarked-points.twig). #}
{% endblock %}

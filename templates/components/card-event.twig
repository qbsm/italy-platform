{# Карточка события для афиши. item — объект события (data/json/{lang}/events/{slug}.json) #}
{% set e = item.event | default({}) %}
{% set d = e.date | default({}) %}
{% set href = item.slug is defined ? '/events/' ~ item.slug : '#' %}
{% set cover = (item.covers | default([]))[0] | default(null) %}
{% set soldOut = e.seatsLeft is defined and e.seatsLeft is not null and e.seatsLeft <= 0 %}

<a class="card-event {{ soldOut ? 'card-event--sold' : '' }}" href="{{ url(href) }}"
   aria-label="{{ e.title | default('Событие') }} — {{ d.day | default('') }} {{ d.month | default('') }}, {{ e.restaurant.name | default('') }}">
  <div class="card-event__media">
    {% if cover %}
      <img src="{{ url(cover.src) }}" alt="{{ cover.alt | default(e.title) }}" class="card-event__img" loading="lazy">
    {% endif %}
    {% if d.day is defined %}
      <span class="card-event__date" aria-hidden="true">
        <span class="card-event__date-day">{{ d.day }}</span>
        <span class="card-event__date-month">{{ d.monthShort | default(d.month) }}</span>
      </span>
    {% endif %}
    {% if e.category is defined and e.category %}
      <span class="card-event__tag">{{ e.category }}</span>
    {% endif %}
    {% if soldOut %}<span class="card-event__badge">Мест нет</span>{% endif %}
  </div>

  <div class="card-event__body">
    {% if e.restaurant.name is defined %}
      <span class="card-event__place">{{ e.restaurant.name }}</span>
    {% endif %}
    <h3 class="card-event__title font-1 weight-500 uppercase">{{ e.titleHtml is defined and e.titleHtml ? e.titleHtml|raw : e.title }}</h3>

    {% set metaParts = [] %}
    {% if d.weekday is defined and d.weekday %}{% set metaParts = metaParts | merge([d.weekday]) %}{% endif %}
    {% if d.time is defined and d.time %}{% set metaParts = metaParts | merge([d.time]) %}{% endif %}
    {% if e.duration is defined and e.duration %}{% set metaParts = metaParts | merge([e.duration]) %}{% endif %}
    {% if metaParts | length %}
      <div class="card-event__meta">{{ metaParts | join(', ') }}</div>
    {% endif %}

    <div class="card-event__foot">
      <span class="card-event__price">
        {% if e.priceFrom is defined and e.priceFrom %}
          {% if not (e.price is defined and e.price) %}<span class="card-event__price-label">от</span>{% endif %}
          <span class="card-event__price-value">{{ e.priceFrom | number_format(0, '', ' ') }} {{ e.currency | default('₽') }}</span>
        {% elseif e.free is defined and e.free %}
          <span class="card-event__price-value">Бесплатно</span>
        {% else %}
          <span class="card-event__price-value card-event__price-value--tba">Цена уточняется</span>
        {% endif %}
      </span>
      <span class="card-event__cta button button-sm {{ soldOut ? 'bg-color-6 color-2' : 'bg-color-1 color-2' }} button-rounded uppercase nowrap">
        {{ soldOut ? 'Лист ожидания' : 'Подробнее' }}
      </span>
    </div>
  </div>
</a>

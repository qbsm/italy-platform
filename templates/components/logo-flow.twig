{# Перетекание логотипа: вверху страницы знак шапки совмещён с логотипом интро,
   при прокрутке плавно уезжает на своё место в шапке — и так же возвращается.

   Геометрию считаем в каждом кадре по факту: шапка на скролле переключается с relative
   на sticky, а на мобильных ещё и схлопывается адресная строка — от разового замера
   знак дёргался. Меряем родителя логотипа (на нём нет transform) и сам знак в интро. #}
<script>
  (function () {
    var intro = document.querySelector('.intro');
    var headerLogo = document.querySelector('.header__logo');
    if (!intro || !headerLogo) { return; }
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { return; }

    var anchor = headerLogo.parentElement || headerLogo;
    var root = document.documentElement;
    var last = -1;

    function currentIntroLogo() {
      return intro.querySelector('.swiper-slide-active .intro__logo') ||
             intro.querySelector('.intro__logo');
    }

    // Знак сначала доезжает и замирает — и только потом наливается цветом. Раньше класс
    // ставился в тот же момент, когда заканчивалось движение, и перекраска читалась как
    // часть переезда. Пауза короткая, но её хватает, чтобы глаз увидел два разных события.
    var dockTimer = null;

    function setDocked(on) {
      if (on) {
        if (dockTimer === null && !root.classList.contains('logo-flow-docked')) {
          dockTimer = setTimeout(function () {
            dockTimer = null;
            root.classList.add('logo-flow-docked');
          }, 320);
        }
        return;
      }

      if (dockTimer !== null) {
        clearTimeout(dockTimer);
        dockTimer = null;
      }
      root.classList.remove('logo-flow-docked');
    }

    function apply() {
      var introLogo = currentIntroLogo();
      if (!introLogo) { return; }

      var to = introLogo.getBoundingClientRect();
      var from = anchor.getBoundingClientRect();
      var introBox = intro.getBoundingClientRect();
      if (!to.width || !from.width) { return; }

      var distance = Math.max(1, introBox.height * 0.55);
      var p = Math.min(1, Math.max(0, window.scrollY / distance));
      var eased = 1 - Math.pow(1 - p, 3);
      var k = 1 - eased;

      var dx = (to.left + to.width / 2) - (from.left + from.width / 2);
      var dy = (to.top + to.height / 2) - (from.top + from.height / 2);
      var scale = to.width / from.width;

      headerLogo.style.setProperty('--logo-flow-x', (dx * k).toFixed(2) + 'px');
      headerLogo.style.setProperty('--logo-flow-y', (dy * k).toFixed(2) + 'px');
      headerLogo.style.setProperty('--logo-flow-scale', (1 + (scale - 1) * k).toFixed(4));

      if (Math.abs(p - last) > 0.005) {
        last = p;
        setDocked(p >= 0.999);
      }
    }

    var ticking = false;
    function schedule() {
      if (ticking) { return; }
      ticking = true;
      requestAnimationFrame(function () { apply(); ticking = false; });
    }

    function start() {
      root.classList.add('logo-flow-on');
      apply();
    }

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    window.addEventListener('orientationchange', schedule);

    if (document.readyState === 'complete') { start(); }
    else { window.addEventListener('load', start, { once: true }); }
  })();
</script>

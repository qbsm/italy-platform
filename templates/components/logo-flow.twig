{# Перетекание логотипа: вверху страницы знак шапки совмещён с логотипом интро,
   при прокрутке плавно уезжает на своё место в шапке — и так же возвращается.

   Работает только там, где есть интро (главная). Логотип интро при этом гасится:
   на экране всегда один знак, который и переезжает. Без JS шапка ведёт себя как раньше. #}
<script>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var intro = document.querySelector('.intro');
    var headerLogo = document.querySelector('.header__logo');
    if (!intro || !headerLogo) { return; }

    var introLogo = intro.querySelector('.swiper-slide-active .intro__logo') ||
                    intro.querySelector('.intro__logo');
    if (!introLogo) { return; }

    var root = document.documentElement;
    var progress = -1;
    var geom = null;

    function measure() {
      // Считаем от нетронутого состояния: снимаем трансформацию на время замера
      headerLogo.style.setProperty('--logo-flow-progress', '1');
      var from = headerLogo.getBoundingClientRect();
      var to = introLogo.getBoundingClientRect();
      if (!from.width || !to.width) { geom = null; return; }

      geom = {
        dx: (to.left + to.width / 2) - (from.left + from.width / 2),
        dy: (to.top + to.height / 2) - (from.top + from.height / 2),
        scale: to.width / from.width,
        distance: Math.max(1, intro.getBoundingClientRect().height * 0.55)
      };
    }

    function apply() {
      if (!geom) { return; }
      var p = Math.min(1, Math.max(0, window.scrollY / geom.distance));
      if (Math.abs(p - progress) < 0.004) { return; }
      progress = p;

      var eased = 1 - Math.pow(1 - p, 3);
      var k = 1 - eased;

      headerLogo.style.setProperty('--logo-flow-x', (geom.dx * k).toFixed(2) + 'px');
      headerLogo.style.setProperty('--logo-flow-y', (geom.dy * k).toFixed(2) + 'px');
      headerLogo.style.setProperty('--logo-flow-scale', (1 + (geom.scale - 1) * k).toFixed(4));
      headerLogo.style.setProperty('--logo-flow-progress', eased.toFixed(3));
      // Цвет знака переключаем раньше, чем он доедет: так смена успевает пройти плавно
      root.classList.toggle('logo-flow-docked', p > 0.62);
    }

    function start() {
      measure();
      if (!geom) { return; }
      root.classList.add('logo-flow-on');
      apply();
    }

    if (reduce.matches) { return; }

    var ticking = false;
    window.addEventListener('scroll', function () {
      if (ticking) { return; }
      ticking = true;
      requestAnimationFrame(function () { apply(); ticking = false; });
    }, { passive: true });

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () { progress = -1; start(); }, 150);
    });

    if (document.readyState === 'complete') { start(); }
    else { window.addEventListener('load', start, { once: true }); }
  })();
</script>

{# Меню события («Гастрономия вечера»): интро + группы блюд, спойлер после первой группы.
   data: {heading?, intro?, groups[{title, items[]}], image?} #}
<div class="event-block event-menu">
  <h2 class="event-h2">{{ data.heading | default('Гастрономия вечера') }}</h2>
  {% if data.intro is defined and data.intro %}
    <p class="event-menu__intro">{{ data.intro }}</p>
  {% endif %}
  <div class="event-menu__groups">
    {% for g in data.groups | slice(0, 1) %}
      <div class="event-menu__group">
        <h3 class="event-menu__group-title uppercase">{{ g.title }}</h3>
        <ul class="event-menu__list">
          {% for it in g.items %}<li class="event-menu__item">{{ it }}</li>{% endfor %}
        </ul>
      </div>
    {% endfor %}
    {% if data.groups | length > 1 %}
      <div class="event-menu__more js-menu-more" hidden>
        {% for g in data.groups | slice(1) %}
          <div class="event-menu__group">
            <h3 class="event-menu__group-title uppercase">{{ g.title }}</h3>
            <ul class="event-menu__list">
              {% for it in g.items %}<li class="event-menu__item">{{ it }}</li>{% endfor %}
            </ul>
          </div>
        {% endfor %}
      </div>
      <button type="button" class="event-menu__toggle js-menu-toggle" aria-expanded="false">Показать всё меню</button>
    {% endif %}
  </div>
  {% if data.image is defined and data.image %}
    <a href="{{ url(data.image) }}" class="glightbox link event-menu__full" data-gallery="event-menu">Открыть меню вечера</a>
  {% endif %}
</div>
